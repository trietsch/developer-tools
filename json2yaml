#!/usr/bin/env python3
# pylint: disable=invalid-name
""" parses a yaml and picks out a field using dpath """
import sys
import json
import yaml

def parse(jsonstream):
    """ turn a yaml file into a json """
    contents = json.load(jsonstream)
    print(yaml.dump(contents))


if __name__ == '__main__':
    if len(sys.argv) == 2:
        with open(sys.argv[1], 'r') as _f:
            parse(_f)
    else:
        parse(sys.stdin)
