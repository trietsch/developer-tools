#!/bin/bash

docker_container_name=$1
docker_port=$2
sql_proxy_port=$3
db_name=$4
user_name=$5
db_password=$6
date=$(date +%s%3)
dump_name=dump_"$date"

Help()
{
     # Display Help
     echo "Clone dev db to local db"
     echo
     echo "Usage: db-clone <docker_container_name> <docker_port> <sql_proxy_port> <db_name> <db_user_name>"
}

PrintStdErr() {
  echo "$1" 1>&2
}

Error()
{
  rm "$dump_name".sql
  echo "Database could not be cloned successfully"
  exit 1
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  Help
  exit 0
fi

if [[ "$#" -ne 6 ]]; then
  echo "Wrong amount of arguments given"
  Help
  exit 1
fi

if [[  "$(nc -z localhost "$sql_proxy_port"; echo $?)" == 1 ]]; then
  echo "cloud sql proxy is not available"
  exit 1
fi

# dump the schema into a temp sql file
PrintStdErr "Creating database dump"
if ! >&2 PGPASSWORD="$db_password" pg_dump --host=localhost --port="$sql_proxy_port" --dbname="$db_name" --username="$user_name" > "$dump_name".sql; then
  Error
fi
# remove local postgres docker
if ! >&2 docker rm --force "$docker_container_name"; then
  Error
fi
# start new docker postgres container
if ! >&2 docker run -d --name "$docker_container_name" -e POSTGRES_USER="$user_name" -e POSTGRES_PASSWORD=postgres -p "$docker_port":5432 postgres:12; then
  Error
fi
# check readiness docker container
PrintStdErr "waiting for container readiness"
until docker exec "$docker_container_name" pg_isready 1>&2 ; do sleep 2 ; done

# create database
PrintStdErr "creating database"
if ! >&2 docker exec -i "$docker_container_name" psql -P pager=off -U "$user_name" -c "CREATE DATABASE \"$db_name\""; then
  Error
fi
# migrate sql schema to newly started postgres container
PrintStdErr "Migrating dev dump to local database"
if ! >&2 docker exec -i "$docker_container_name" psql -U "$user_name" -d "$db_name" < "$dump_name".sql; then
  Error
fi
# remove dump file
PrintStdErr "remove sql dump file"
rm "$dump_name".sql
PrintStdErr "clone successful"

