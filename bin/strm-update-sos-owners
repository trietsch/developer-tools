#!/bin/bash

set -e

deployments=$(kubectl get deployments.apps \
    -l io.streammachine/resource-owner=SOS \
    --namespace=customers \
    -o name | sed -e 's/.*\///g' )

if [ -z "$deployments" ] ; then
    echo "No deployments matching streammachine/resource-owner=SOS"
    exit 0
fi
set -x
echo $deployments | while read d ; do
    kubectl label --namespace=customers deployments $d \
        io.strmprivacy/resource-owner=SOS \
        --overwrite
    kubectl label --namespace=customers deployments $d \
        io.streammachine/resource-owner-
done

# vim:syntax=sh
