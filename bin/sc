#!/usr/bin/env bash

# Originally created by Bart van Deenen, added to dev tools by Robin

if ! command -v fzf &> /dev/null
then
    echo "Fuzzy Finder (https://github.com/junegunn/fzf) could not be found. Please install it to use this script"
fi

# Sets the strm-config, by looking into ~/.config/strmprivacy for config.yaml files
cd ~/.config/strmprivacy
eval "p=$(find . -name config.yaml | xargs dirname | xargs basename -a | sort -r | fzf --preview \
    'f=$(realpath {1}); echo "Config Path:"; echo $f; echo; echo "Email:"; cat {1}/strm-creds*.json | jq -r .email; echo; echo "config.yaml:"; cat {1}/config.yaml;' --preview-window=right:66%:wrap)"
if [ ! -z "$p" ] ; then
    export STRM_CONFIG_PATH=$(realpath $p)
fi
cd - > /dev/null
echo "STRM_CONFIG_PATH=$STRM_CONFIG_PATH"
