#!/bin/bash

set -e

read -p "app label to select deployments ? " app
deployments=$( kubectl get --namespace=customers deployments -l app=$app \
    -o name | sed -e 's/.*\///g' )

read -p "Container nr inside deployment spec (default 0)? " container
container=${container:-0}
echo "Will modify container # $container in these deployments"
kubectl get deployments.apps --namespace=customers -l app=$app -o \
    custom-columns=name:..metadata.name,"current image":.spec.template.spec.containers[$container].image
echo
echo

read -p "full k8s image ? " image
patch=$(echo '[{"op": "replace",
    "path": "/spec/template/spec/containers/CN/image",
    "value": "IMAGE"}]' | m4 -DCN=$container -DIMAGE="$image" | \
    tr -d ' \r\n'
)
echo "patching via kubectl patch deployment ..."

read -p "Update image to $image ? " c
if [ "$c" != "Y" -a "$c" != "y" ] ; then
    echo "aborting"
    exit 0
fi


echo $deployments | while read d ; do
kubectl patch deployment $d --type=json -p=$patch
done

# vim:syntax=sh
