#!/bin/bash
tmp=$(mktemp)

cleanup() {
    rm -f $tmp
}

trap cleanup EXIT

cat <<EOF > $tmp
    .items[] |
    select(.metadata.name | startswith("telepresence") | not) |
    {
        ns:.metadata.namespace,
        name:.metadata.name,
        images: [
            .spec.containers[].image |
                 ltrimstr("eu.gcr.io/stream-machine-development/")
            ]
    }
EOF
for ns in core
do
    kubectl get pods --namespace=$ns -o=json | jq -c -f $tmp
done
