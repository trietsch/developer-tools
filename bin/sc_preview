#!/usr/bin/env bash

# Originally created by Bart van Deenen, added to dev tools by Robin
dir="$1"

echo "Config path:"
echo "$(realpath $dir)"

f=$(basename $dir)
if [ "$STRM_CONTEXT_WITH_ICONS" = true ] ; then
    icon=$(basename $(ls $dir/icon-[PD]*))
    icon=" ${icon##icon-[PD]} "
fi

echo
echo "Environment:"
grep "\.dev" $dir/config.yaml > /dev/null
if [ $? -eq 0 ] ; then
    echo "[32mDEV$icon[0m"
else
    echo "[31mPROD$icon[0m"
fi

echo
echo "Email:"
if [ -f $dir/strm-creds*.json ] ; then
    cat $dir/strm-creds*.json | jq -r .email
else
    echo "not logged in"
fi
echo
echo "config.yaml:"
cat $dir/config.yaml | sed -e 's/^#.*/[2m&[0m/g'
