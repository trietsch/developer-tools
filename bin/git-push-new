#!/bin/bash

# Push a new branch to the remote and open the remote URL to create an MR/PR
# Add as an alias to your gitconfig:
# push-new = "!git-push-new"

# Usage: git push-new

open_url() {
    local url="$1"
    if [ ! -z "${url}" ]; then
        /usr/bin/open "$url"
    fi
}

extract_url_from_push_output() {
    local push_output="$1"
    local url
    
    # Try GitLab/general format first
    url=$(echo "$push_output" | grep -iE '/merge_requests/|Create a pull request.*by visiting:' | awk '{ print $2 }')
    
    # Try GitHub format if no URL found
    if [ -z "${url}" ]; then
        url=$(echo "$push_output" | grep -o 'https://github.com[^ ]*')
    fi
    
    echo "$url"
}

create_azure_devops_pr_url() {
    local current_branch="$1"
    local remote_url=$(git remote get-url origin)
    
    if [[ "$remote_url" =~ ^git@ssh.dev.azure.com:v3/(.*)$ ]]; then
        # SSH: org/project/repo
        path_part="${BASH_REMATCH[1]}"
        IFS='/' read -r org project repo <<< "$path_part"
        org_escaped="${org// /%20}"
        project_escaped="${project// /%20}"
        repo_escaped="${repo// /%20}"
        remote_url="https://dev.azure.com/${org_escaped}/${project_escaped}/_git/${repo_escaped}"
    elif [[ "$remote_url" =~ ^https://.*@dev.azure.com/(.*)$ ]]; then
        path_part="${BASH_REMATCH[1]}"
        path_part_escaped="${path_part// /%20}"
        remote_url="https://dev.azure.com/${path_part}"
    fi
    
    local repo_name=$(basename "$remote_url")
    echo "${remote_url}/pullrequestcreate?sourceRef=${current_branch}&targetRef=main&sourceRepositoryId=${repo_name}&targetRepositoryId=${repo_name}"
}

current_branch=$(git branch --show-current)
res=$(git push -u origin "$current_branch" 2>&1)

# Try to extract URL from push output
url=$(extract_url_from_push_output "$res")

if [ ! -z "${url}" ]; then
    open_url "$url"
elif git remote get-url origin | grep -q 'dev.azure.com'; then
    # Azure DevOps does not return a URL in the push output, so we construct it manually
    azure_url=$(create_azure_devops_pr_url "$current_branch")
    open_url "$azure_url"
fi

echo "$res"
