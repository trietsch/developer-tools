#!/usr/bin/env bash
# ehcat - kcat wrapper for Azure Event Hubs, authenticating with your `az login` identity
#
# Usage: ehcat --subscription <subscription> [--namespace <namespace>] [kcat args...]
# Example: ehcat --subscription my-subscription -t my-event-hub -C -o end
#
# librdkafka (kcat) cannot take a static token, so a local token endpoint serves a fresh
# `az account get-access-token` result whenever librdkafka requests or refreshes its token.
set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") --subscription <subscription> [--namespace <namespace>] [kcat args...]" >&2
  exit 1
}

subscription=""
namespace=""
kcat_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --subscription) subscription="${2:-}"; shift 2 || usage ;;
    --subscription=*) subscription="${1#*=}"; shift ;;
    --namespace) namespace="${2:-}"; shift 2 || usage ;;
    --namespace=*) namespace="${1#*=}"; shift ;;
    -F)
      echo "ehcat provides its own config file (-F); use -X <property>=<value> for extra settings" >&2
      exit 1
      ;;
    *) kcat_args+=("$1"); shift ;;
  esac
done
[[ -z "$subscription" ]] && usage

namespace_query='[].[name,id]'
[[ -n "$namespace" ]] && namespace_query="[?name=='${namespace}'].[name,id]"
namespaces=()
namespace_ids=()
while IFS=$'\t' read -r name id; do
  [[ -n "$name" ]] && namespaces+=("$name") && namespace_ids+=("$id")
done < <(az eventhubs namespace list --subscription "$subscription" --query "$namespace_query" -o tsv)
if [[ ${#namespaces[@]} -ne 1 ]]; then
  echo "Expected exactly one Event Hubs namespace${namespace:+ named '$namespace'} in '$subscription', found ${#namespaces[@]}: ${namespaces[*]:-}" >&2
  [[ -z "$namespace" ]] && echo "Pass one explicitly with --namespace <namespace>" >&2
  exit 1
fi
namespace="${namespaces[0]}"
namespace_id="${namespace_ids[0]}"

kcat_arg() {
  local flag="$1" i
  for ((i = 0; i < ${#kcat_args[@]}; i++)); do
    [[ "${kcat_args[i]}" == "$flag" ]] && echo "${kcat_args[i + 1]:-}" && return
  done
  return 0
}

has_kcat_flag() {
  local flag="$1" arg
  for arg in "${kcat_args[@]}"; do
    [[ "$arg" == "$flag" ]] && return 0
  done
  return 1
}

check_permissions() {
  local event_hub operation scope data_actions pattern
  event_hub="$(kcat_arg -t)"
  operation="receive"
  has_kcat_flag -P && operation="send"
  scope="${namespace_id}${event_hub:+/eventhubs/${event_hub}}"
  local required_action="Microsoft.EventHub/namespaces/messages/${operation}/action"

  if ! data_actions="$(az rest --method get \
    --uri "https://management.azure.com${scope}/providers/Microsoft.Authorization/permissions?api-version=2022-04-01" \
    --query 'value[].dataActions[]' -o tsv 2>/dev/null)"; then
    echo "Warning: could not verify your permissions on ${scope}, continuing" >&2
    return
  fi

  shopt -s nocasematch
  while IFS= read -r pattern; do
    # shellcheck disable=SC2053 # data actions may contain wildcards, so match as a glob
    if [[ -n "$pattern" && "$required_action" == $pattern ]]; then
      shopt -u nocasematch
      return
    fi
  done <<<"$data_actions"
  shopt -u nocasematch

  local role="Azure Event Hubs Data Receiver"
  local preposition="from"
  [[ "$operation" == "send" ]] && role="Azure Event Hubs Data Sender" && preposition="to"
  echo "Permission denied: you cannot ${operation} ${preposition} ${event_hub:+event hub '${event_hub}' in }namespace '${namespace}'" >&2
  echo "Missing data action ${required_action}; request (or activate via PIM) the '${role}' role" >&2
  exit 1
}

check_permissions

host="${namespace}.servicebus.windows.net"
port="${KCAT_AZ_TOKEN_PORT:-18765}"
work_dir="$(mktemp -d)"
fifo="${work_dir}/response"
properties="${work_dir}/kcat.properties"
server_pid=""

cleanup() {
  [[ -n "$server_pid" ]] && kill "$server_pid" 2>/dev/null || true
  pkill -f "nc -l 127.0.0.1 ${port}" 2>/dev/null || true
  rm -rf "$work_dir"
}
trap cleanup EXIT INT TERM

get_token() {
  az account get-access-token --subscription "$subscription" --scope "https://${host}/.default" --query accessToken -o tsv
}

token_response() {
  local body
  body="{\"access_token\":\"$(get_token)\",\"token_type\":\"Bearer\"}"
  printf 'HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s' \
    "${#body}" "$body"
}

serve_tokens() {
  mkfifo "$fifo"
  while true; do
    nc -l 127.0.0.1 "$port" <"$fifo" | {
      read -r _request_line
      token_response
    } >"$fifo" || true
  done
}

get_token >/dev/null

cat >"$properties" <<EOF
metadata.broker.list=${host}:9093
security.protocol=sasl_ssl
sasl.mechanisms=OAUTHBEARER
sasl.oauthbearer.method=oidc
sasl.oauthbearer.client.id=unused
sasl.oauthbearer.client.secret=unused
sasl.oauthbearer.token.endpoint.url=http://127.0.0.1:${port}/token
EOF

serve_tokens &
server_pid=$!

kcat -F "$properties" "${kcat_args[@]}"
