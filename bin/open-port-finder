#!/bin/bash

number_of_ports=$1
number_of_ports=$((number_of_ports))
ports_found=0
ports=""
ports_in_use=()

Help()
{
     # Display Help
     echo "Find open ports and return them in a string seperated by commas"
     echo
     echo "Usage: open-port-finder <number of open ports>"
}

PrintStdErr() {
  echo "$1" 1>&2
}

Error()
{
  echo "Couldn't find open ports"
  exit 1
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  Help
  exit 0
fi

if [[ "$#" -ne 1 ]]; then
  echo "Wrong amount of arguments given"
  Help
  exit 1
fi

while
   [[ "$ports_found" != "$number_of_ports" ]]
do
  while
    port=$(shuf -n 1 -i 49152-65535)
    netstat -atun | grep -q "$port"
  do
    continue
  done
  if [[ "${ports_in_use[*]}" == "${port}" ]]; then
    continue
  fi
  ports_in_use+=("$port")
  ports_found=$((ports_found+1))
  ports="$ports$port"
  if [[ "$ports_found" -ne "$number_of_ports" ]]; then
    ports="$ports,"
  fi
done

echo "$ports"
